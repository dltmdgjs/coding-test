#include <iostream>

#define MAX 501
using namespace std;

// 최적 곱셈 순서 출력 함수
void optimal_order(int T[][MAX], int i, int j) {
    if (i==j) {
        cout << i;
    } else {
        cout << "(";
        optimal_order(T, i, T[i][j]);
        optimal_order(T, T[i][j]+1, j);
        cout << ")";
    }
}



int main() {
    int n; // 행렬의 개수
    cin >> n;

    int row[MAX], col[MAX];
    int S[MAX][MAX] = {0}; // S[i][j]는 i번째 행렬부터 j번째 행렬까지 곱하는데 드는 최소 횟수
    int K[MAX][MAX] = {0}; // 최적 분할 위치 저장 (필요시 사용)

    // 행렬의 크기 입력
    for (int i = 1; i <= n; i++) {
        cin >> row[i] >> col[i];
    }

    for (int d = 2; d <= n; d++) { // d : 부분 문제의 크기 (곱할 행렬의 개수)
        for (int i = 1; i <= n - d + 1; i++) { // i : 부분 문제의 시작 인덱스
            int j = i + d - 1; // j : 부분 문제의 끝 인덱스
            S[i][j] = 2147483647; // i번째 행렬부터 j번째 행렬까지 곱하는데 드는 최소 횟수 초기화(큰값으로)
            
            // k : 분할 위치 (앞서 계산했던 부문제의 결과를 이용)
            for (int k = i; k < j; k++) {
                if (S[i][j] > S[i][k] + S[k+1][j] + row[i] * col[k] * col[j]) {
                    S[i][j] = S[i][k] + S[k+1][j] + row[i] * col[k] * col[j]; // 최소 횟수 갱신
                    K[i][j] = k; // 최적 분할 위치 저장
                }
            }
        }
    }
    // 결과 출력 - 최소 곱셈 횟수
    cout << S[1][n] << '\n';

    // 최적 곱셈 순서 출력
    // optimal_order(K, 1, n);
    return 0;
}

// 시각화
// 행렬 A1(10x20), A2(20x30), A3(30x40) 일 때
// cost 계산 예시:

// len = 2 ---------------------------------------------
// i = 1, j = 2, k = 1 ------
// cost = dp[1][1] + dp[2][2] + row[1] * col[1] * col[2]
//      = 0 + 0 + 10 * 20 * 30 = 6000
// dp[1][2] = 6000
// i = 2, j = 3, k = 2 ------
// cost = dp[2][2] + dp[3][3] + row[2] * col[2] * col[3]
//      = 0 + 0 + 20 * 30 * 40 = 24000
// dp[2][3] = 24000

// len = 3 ---------------------------------------------
// i = 1, j = 3, k = 1 ------
// cost = dp[1][1] + dp[2][3] + row[1] * col[1] * col[3]
//      = 0 + 24000 + 10 * 20 * 40 = 32000
// dp[1][3] = 32000
// i = 1, j = 3, k = 2 ------
// cost = dp[1][2] + dp[3][3] + row[1] * col[2] * col[3]
//      = 6000 + 0 + 10 * 30 * 40 = 18000
// dp[1][3] = min(32000, 18000) = 18000

// 최종 결과: dp[1][3] = 18000 (A1, A2, A3를 곱하는 최소 곱셈 횟수)
// 즉, (A1 x (A2 x A3)) 순서로 곱하는 것이 최소 곱셈 횟수를 가짐.

// 왜 이런 점화식이 나오는가?
// 행렬 곱셈의 특성상, (A x B) x C 와 A x (B x C) 는 결과가 같지만, 곱셈 연산의 수는 다를 수 있음.
// 따라서, 행렬 곱셈의 순서를 최적화하는 것이 중요하며, 이를 위해 분할 정복과 동적 계획법을 활용함.
// dp[i][k]는 i번째 행렬부터 k번째 행렬까지 곱하는데 드는 최소 횟수,
// dp[k+1][j]는 k+1번째 행렬부터 j번째 행렬까지 곱하는데 드는 최소 횟수를 의미함.
// 마지막 항 row[i] * col[k] * col[j]는 i번째 행렬의 행 수, k번째 행렬의 열 수, j번째 행렬의 열 수를 곱한 것으로, 이 세 행렬을 곱할 때 추가로 필요한 곱셈 연산의 수를 나타냄.
// 이를 통해 전체 행렬 곱셈의 최소 곱셈 횟수를 계산할 수 있음.

// 만약 행렬의 수가 4개(A1, A2, A3, A4)라면?
// 행렬 A1(10x20), A2(20x30), A3(30x40), A4(40x50) 일 때
// cost 계산 예시:

// len = 2 ---------------------------------------------
// i = 1, j = 2, k = 1 ------
// cost = dp[1][1] + dp[2][2] + row[1] * col[1] * col[2]
//      = 0 + 0 + 10 * 20 * 30 = 6000
// dp[1][2] = 6000
// i = 2, j = 3, k = 2 ------
// cost = dp[2][2] + dp[3][3] + row[2] * col[2] * col[3]
//      = 0 + 0 + 20 * 30 * 40 = 24000
// dp[2][3] = 24000
// i = 3, j = 4, k = 3 ------
// cost = dp[3][3] + dp[4][4] + row[3] * col[3] * col[4]
//      = 0 + 0 + 30 * 40 * 50 = 60000
// dp[3][4] = 60000

// len = 3 ---------------------------------------------
// i = 1, j = 3, k = 1 ------
// cost = dp[1][1] + dp[2][3] + row[1] * col[1] * col[3]
//      = 0 + 24000 + 10 * 20 * 40 = 32000
// dp[1][3] = 32000
// i = 1, j = 3, k = 2 ------
// cost = dp[1][2] + dp[3][3] + row[1] * col[2] * col[3]
//      = 6000 + 0 + 10 * 30 * 40 = 18000
// dp[1][3] = min(32000, 18000) = 18000
// i = 2, j = 4, k = 2 ------
// cost = dp[2][2] + dp[3][4] + row[2] * col[2] * col[4]
//      = 0 + 60000 + 20 * 30 * 50 = 90000
// dp[2][4] = 90000
// i = 2, j = 4, k = 3 ------
// cost = dp[2][3] + dp[4][4] + row[2] * col[3] * col[4]
//      = 24000 + 0 + 20 * 40 * 50 = 64000
// dp[2][4] = min(90000, 64000) = 64000

// len = 4 ---------------------------------------------
// i = 1, j = 4, k = 1 ------
// cost = dp[1][1] + dp[2][4] + row[1] * col[1] * col[4]
//      = 0 + 64000 + 10 * 20 * 50 = 74000
// dp[1][4] = 74000
// i = 1, j = 4, k = 2 ------
// cost = dp[1][2] + dp[3][4] + row[1] * col[2] * col[4]
//      = 6000 + 60000 + 10 * 30 * 50 = 90000
// dp[1][4] = min(74000, 90000) = 74000
// i = 1, j = 4, k = 3 ------
// cost = dp[1][3] + dp[4][4] + row[1] * col[3] * col[4]
//      = 18000 + 0 + 10 * 40 * 50 = 38000
// dp[1][4] = min(74000, 38000) = 38000

// 최종 결과: dp[1][4] = 38000 (A1, A2, A3, A4를 곱하는 최소 곱셈 횟수)
// ((A1 x A2) x A3) x A4 순서로 곱하면,
// A1 x A2 = 10x20 x 20x30 = 10x30 행렬, 횟수 6000회
// (A1xA2) x A3 = 10x30 x 30x40 = 10x40 행렬, 횟수 12000회
// ((A1xA2)xA3) x A4 = 10x40 x 40x50 = 10x50 행렬, 횟수 20000회
// 총 횟수는 6000 + 12000 + 20000 = 38000회가 됨. 이것이 최소비용임.
