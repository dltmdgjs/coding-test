#include<bits/stdc++.h>
using namespace std; 
int n, m, mx, visited[54][54]; 
const int dy[] = {-1, 0, 1, 0}; 
const int dx[] = {0, 1, 0, -1}; 
char a[54][54];

// <차이점 및 개선점>
// ======================================================

// 1 :  나는 먼저 연결된 육지를 하나의 그룹으로 만든 뒤,
//      그 그룹에서 육지 2개를 조합으로 선택하고 두 지점마다 BFS를 실행함.
//
//      해설에서는 연결된 육지 그룹을 따로 만들 필요가 없음.
//      어떤 육지에서 BFS를 시작하면 물(W)을 통과할 수 없기 때문에
//      자연스럽게 같은 연결 요소에 속한 육지만 탐색하게 됨.

// ======================================================

// 2 :  나는 두 육지의 모든 조합을 만들고,
//      조합 하나마다 BFS를 실행해서 두 지점 사이의 최단거리를 계산함.
//
//      하지만 BFS를 한 번 실행하면 시작점에서 도달 가능한 모든 육지까지의
//      최단거리를 한꺼번에 구할 수 있음.
//
//      따라서 굳이 (시작점, 끝점) 쌍을 하나씩 만들어 BFS를 반복할 필요가 없고,
//      각 육지를 시작점으로 한 번씩만 BFS하면 됨.

// ======================================================

// 3 :  내 방식은 같은 영역을 매우 많이 다시 탐색하게 됨.
//
//      육지가 K개라면 나는 최대 C(K, 2)개의 쌍에 대해 BFS를 실행하므로
//      대략 O(K^3)의 시간이 필요할 수 있음.
//
//      해설은 각 육지를 시작점으로 BFS를 한 번씩 실행하므로
//      대략 O(K^2) 수준으로 해결할 수 있음.
//
//      따라서 내 풀이의 논리는 맞지만 육지가 많으면 시간 초과가 발생할 수 있음.

// ======================================================

// 4 :  내 코드에서는 visited를 육지 그룹을 만들기 위한 방문 체크로 사용하고,
//      실제 거리 계산 BFS에서는 별도의 check 배열을 사용함.
//
//      해설에서는 그룹을 만들지 않기 때문에 visited 하나만 사용하며,
//      BFS를 시작할 때마다 초기화해서
//      '방문 여부 + 시작점으로부터의 거리'를 동시에 저장함.

void bfs(int y, int x){
    memset(visited, 0, sizeof(visited)); 
    visited[y][x] = 1; 
    queue<pair<int, int>> q; 
    q.push({y, x}); 
    while(q.size()){
        tie(y, x) = q.front(); q.pop(); 
        for(int i = 0; i < 4; i++){
            int ny = y + dy[i]; 
            int nx = x + dx[i]; 
            if(ny < 0 || ny >= n || nx < 0 || nx >= m) continue; 
            if(visited[ny][nx]) continue; 
            if(a[ny][nx] == 'W')continue;
            visited[ny][nx] = visited[y][x] + 1; 
            q.push({ny, nx});
            mx = max(mx, visited[ny][nx]);
        }
    }
    return;
}

int main(){
    cin >> n >> m; 
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin >> a[i][j]; 
        }
    }
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            if(a[i][j] == 'L') bfs(i, j); 
        }
    } 
    cout << mx - 1 << "\n";
}
